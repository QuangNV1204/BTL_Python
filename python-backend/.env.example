# Giữ cùng biến môi trường với java-backend/.env để frontend chỉ cần đổi cổng/URL backend.
PORT=8080
DBMS_CONNECTION=jdbc:mysql://localhost:3306/learningai
DBMS_USERNAME=your_username
DBMS_PASSWORD=your_password
# Có thể dùng trực tiếp URL SQLAlchemy thay cho bộ ba DBMS_* ở trên:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/learningai?charset=utf8mb4

# Bắt buộc khi chạy, phải là Base64 của >= 32 byte — cùng định dạng với java-backend.
# Sinh bằng: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SIGNING_KEY=your_jwt_signing_key
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

APP_FRONTEND_BASE_URL=http://localhost:5173
APP_STORAGE_LOCATION=./uploads
APP_STORAGE_PUBLIC_BASE_URL=/api/v1/files
LESSON_DOCUMENT_STORAGE=./data/lesson-documents
MAX_THUMBNAIL_BYTES=5242880
# Chu kỳ quét document_cleanup_jobs (ms); 0 = tắt job nền.
CLEANUP_DELAY_MS=60000

AI_PROVIDER=mock
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_SOURCE_CHARS=20000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS cho frontend Vite; nhiều origin cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173
